<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device.

  `android:allowBackup="false"` alone is not enough: cloud backup and
  device-to-device transfer are configured separately, and both default to
  permissive. The cache holds plaintext and the keystore-wrapped preferences
  hold the user key, so an omission here ships the exposure.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
