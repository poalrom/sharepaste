    <string name="pair_step_scan" translatable="false">02</string>
    <string name="pair_label_heading">NAME THIS PHONE</string>
    <string name="pair_label_explainer">Shown beside every Entry from this phone. It cannot be
        changed later.</string>
    <string name="pair_label_field">This phone\u2019s name</string>
    <string name="pair_label_placeholder">Pixel in my pocket</string>
    <string name="pair_scan_heading">SCAN THE CODE ON YOUR COMPUTER</string>
    <string name="pair_scan_explainer">On your computer, open Sharepaste and choose Pair a
        device.</string>
    <string name="pair_needs_a_name">Name this phone first — the code is only good for two
        minutes, so we would rather ask now than lose it.</string>
    <string name="pair_typed_heading">OR TYPE THE CODE</string>
    <string name="pair_typed_explainer">Case and dashes do not matter.</string>
    <string name="pair_typed_field">Pairing code</string>
    <string name="pair_button">PAIR THIS PHONE</string>
    <string name="pair_working">PAIRING\u2026</string>

    <!-- The viewfinder's own chrome. -->
    <string name="pair_viewfinder_title">VIEWFINDER</string>
    <string name="pair_viewfinder_code">BACK CAMERA</string>
    <string name="pair_viewfinder_hint">POINT AT THE SQUARE ON THE PAIR A DEVICE SCREEN</string>
    <!--
      What the viewfinder says once it has done its job. A scan fills the code
      field rather than pairing, so this has to point at the field and say what
      is still missing — the name — and how to get the camera back.
    -->
    <string name="pair_code_scanned">Code read. It is in the field below — name this phone, then
        Pair. Clear the field to point the camera at another code.</string>

    <!-- The three camera and code failures, each said in its own words. -->
    <string name="camera_permission_refused">Sharepaste cannot use the camera, so it cannot read
        the square code. You can turn camera access on in Settings, or type the code
        underneath the square instead — that works just as well.</string>
    <!--
      Beside the refusal, because the app notices a grant on its own: it re-reads
      the permission whenever it comes back to the front and while this sentence
      is on screen. The control is for the person who would rather not trust that.
    -->
    <string name="camera_recheck">CHECK AGAIN</string>
    <string name="camera_absent">This phone has no camera Sharepaste can use, so there is nothing
        to point at the square code. Type the code printed underneath it instead.</string>
    <string name="pair_code_expired">That code has already expired. A pairing code is only good
        for two minutes, on purpose — anyone who reads it over your shoulder can pair with it.
        Ask your computer for a fresh one and scan again.</string>
    <string name="pair_not_a_code">That is not a Sharepaste pairing code. Check you scanned the
        square on the Pair a device screen, or retype the code underneath it.</string>
    <string name="pair_refused">Your computer\u2019s Relay turned this phone away. The code may
        already have been used by another device — ask for a fresh one.</string>
    <string name="pair_unreachable">Sharepaste could not reach the Relay. Check this phone has a
        working connection, then try the code again — you have two minutes from when your
        computer showed it.</string>
    <!--
      The one failure that shows the core's own words underneath it. The core
      names the relay's address and why cleartext is refused, and no wording
      here could be as specific.
    -->
    <string name="pair_insecure_relay">That code points at a Relay served over plain
        http://. Sharepaste will not send this phone\u2019s access token over a connection
        anyone on the network can read, so it refused before connecting.</string>
    <string name="pair_failed">Pairing did not go through. Ask your computer for a fresh code and
        try again.</string>
    <string name="pair_dismiss">TRY AGAIN</string>
    <string name="pair_failed_badge">DID NOT PAIR</string>

    <!-- History -->
    <!-- The identity band's own name for the product. -->
    <string name="history_title">SHAREPASTE</string>
    <!-- %1$s is the User, %2$s the Relay host. Which Pairing is on screen. -->
    <string name="history_identity">%1$s @ %2$s</string>
    <!-- The User slot while the Relay has not yet said who this phone is. -->
    <string name="history_identity_unknown">\u2026</string>
    <string name="history_empty_heading">NOTHING HERE YET</string>
    <string name="history_empty_body">Anything you copy on a paired computer shows up here as an
        Entry. Nothing has been offered yet.</string>

    <!--
      The Filter. Chrome in capitals; the two lines that are spoken rather than
      drawn are sentence case, because TalkBack reads them out as speech.
    -->
    <string name="filter_placeholder">FILTER HISTORY</string>
    <!-- The field's accessible name. It has no label: the band is 56dp. -->
    <string name="filter_field">Filter history</string>
    <string name="filter_clear">Clear filter</string>
    <!-- %1$d rows left, %2$d Entries held. Announced, never drawn. -->
    <string name="filter_count_spoken">%1$d of %2$d shown</string>
    <string name="history_no_matches">NO MATCHES</string>
    <!--
      Shown under NO MATCHES only when the cache is full, where "nothing here"
      and "nothing anywhere" stop being the same statement. The number is the
      core's MAX_PER_USER, and it counts from Last Use rather than from capture
      (ADR 0011).
    -->
    <string name="history_cache_boundary">This phone keeps the 100 most recently used
        entries.</string>

    <!-- A row. The Preview itself is the facade's and is never re-worded here. -->
    <!--
      Two parts, because the row draws two. The marker names the state in the
      product's own word; the sentence underneath says what it means, and it is
      the sentence a test reads back.
    -->
    <string name="entry_undecryptable_marker">\u2298 UNDECRYPTABLE</string>
    <string name="entry_undecryptable">SEALED WITH A KEY THIS PHONE DOES NOT HAVE</string>
    <string name="entry_recall">RECALL</string>
    <string name="entry_delete">DELETE</string>
    <!--
      Shown only for an Entry captured on another Device. %1$s is its Origin,
      which is a name a person chose and is never re-cased.
    -->
    <string name="entry_origin">FROM %1$s</string>
    <!--
      A refused row's second line. %1$s is the Relay's own words, neither
      re-cased nor re-worded — the rule the Origin above follows, for the same
      reason: it is a sentence somebody else wrote.

      The state is named in front of it because the reason on its own says what
      went wrong without saying what it is, and colour is not a fact TalkBack
      can read. `RESEND` and not `RETRY`: a Resend is a fresh act at the back of
      the queue, carrying nothing forward from the refusal.
    -->
    <string name="entry_refused">REFUSED \u00b7 %1$s</string>
    <string name="entry_resend">RESEND</string>

    <!--
      Offer and Recall. Not "Standing Actions": those are the verbs a closed
      phone exposes, and they keep the long titles below, because a notification
      action has no surrounding screen to say what it acts on.
    -->
    <string name="offer_button">Offer what I copied</string>
    <string name="recall_latest_button">Recall the latest Entry</string>
    <!--
      The same two verbs on the open screen, where the screen is the context.
      `RECALL FIRST` and not `RECALL LATEST`: it hands over the first row of the
      displayed list, which a Filter may have narrowed, and it fetches nothing
      (ADR 0010). The notification's verb above is still `latest` and still
      fetches.
    -->
    <string name="offer_bar">OFFER</string>
    <string name="recall_first_bar">RECALL FIRST</string>
    <string name="notice_dismiss">DISMISS</string>

    <!--
      Every notice is labelled with the outcome it reports, in one or two words,
      before the sentence that explains it. The same five the invisible activity
      shows over whatever a person was doing — a Standing Action and an in-app
      press are the same operation and must not report it in two idioms.
    -->
    <string name="notice_offered">OFFERED</string>
    <string name="notice_already_saved">ALREADY SAVED</string>
    <string name="notice_recalled">RECALLED</string>
    <string name="notice_not_paired">NOT PAIRED</string>
    <string name="notice_cleared">CLEARED</string>
    <string name="notice_forgotten">FORGOTTEN</string>
    <string name="notice_failed">DID NOT WORK</string>
    <!-- One per reachable refusal, naming what to do about it. -->
    <string name="notice_nothing_to_send">NOTHING TO SEND</string>
    <string name="notice_too_big">TOO BIG · 64 KB CAP</string>
    <string name="notice_refused">REFUSED</string>
    <string name="notice_nothing_to_recall">NOTHING TO RECALL</string>
    <!-- The share sheet's own refusal, per the mock's off-app surface. -->
    <string name="notice_refused_sensitive">REFUSED · FLAGGED SENSITIVE</string>

    <string name="offer_queued">Offered. Sharepaste sends it to the Relay while this app is
        open.</string>
    <string name="offer_recognised">Already saved. Sharepaste moved it to the top of your
        History.</string>
    <string name="offer_failed">Sharepaste could not offer that.</string>
    <string name="action_unpaired">This phone is not paired yet, so there is nothing to offer to
        and nothing to recall. Pair it with your computer first.</string>

    <!--
      The two refusals an Offer can actually receive, each needing a different
      thing done about it. A rejection with no reason is a button that does
      nothing, which is the one outcome a person cannot act on.
    -->
    <string name="offer_refused_non_text">There is nothing on the clipboard Sharepaste can send.
        It syncs text — copy a link, a note or a code and offer that.</string>
    <string name="offer_refused_too_large">That is too big to send. An Entry can be up to 64 KB;
        put the long version somewhere else and offer a link to it.</string>
    <!--
      Unreachable by construction: the four remaining reasons describe Watched
      Capture, which a phone never performs, and the facade passes their inputs
      in inert. One sentence rather than four that can never be read, worded as
      the surprise it would be.
    -->
    <string name="offer_refused_unreachable">Sharepaste refused that for a reason that cannot
        apply to a phone, and nothing was sent. This is worth reporting.</string>

    <string name="recall_done">On the clipboard. Paste it wherever you were going.</string>
    <!--
      The same outcome with the Preview named, for when Sharepaste is asked to
      say what arrived. %1$s is the Preview, which is the facade's and is never
      re-worded here.
    -->
    <string name="receipt_recalled">On the clipboard: %1$s</string>
    <!--
      The one sentence that may never be missing, and now the Standing Actions'
      alone: `RECALL FIRST` on the open screen selects from the cache and never
      fetches, so it has nothing to fall back from (ADR 0010). The
      notification's Recall Latest still tries the Relay; when the try fails,
      the Entry this phone already had is still the best answer available — but
      it may be yesterday's link, and the person is the only one who can tell.
    -->
    <string name="recall_from_cache">Sharepaste could not reach the Relay, so this is the newest
        Entry it already had. Anything you copied on your computer since then is not here yet —
        open Sharepaste again once you have a connection.</string>
    <!-- Its label. Said out loud as a Receipt, because a Toast has no band. -->
    <string name="recall_from_cache_badge">MAY BE STALE</string>
    <string name="recall_nothing_to_recall">There is nothing to recall. Either this History is
        empty, or that Entry is Undecryptable and this phone holds no plaintext for it.</string>
    <string name="recall_failed">Sharepaste could not recall that.</string>
    <string name="delete_failed">Sharepaste could not delete that Entry. It is still on the
        Relay, so it will come back — try again once you have a connection.</string>
    <!-- Requeueing is local work, so a failure here is not a connection. -->
    <string name="resend_failed">Sharepaste could not put that Entry back in the queue. It is
        still refused and still on this phone; nothing was lost.</string>

    <!--
      ===================================================================
      Standing Actions: the two verbs a closed phone exposes, and the
      share target beside them. The notification's own copy lives here
      too — and none of it may ever contain a Preview, an Entry or
      anything derived from one. See `StandingActions`.
      ===================================================================
    -->
    <string name="standing_actions_channel">Standing Actions</string>
    <string name="standing_actions_channel_description">A quiet, permanent notification carrying
        Offer and Recall, so both work without opening Sharepaste. It never shows what an Entry
        says.</string>
    <!--
      Fixed words, both of them. Not a Preview, not a count, not the newest
      Entry's first line — nothing derived from anything a person copied. One
      tap on Recall hands the last copied secret to whoever is holding the
      phone, so the notification is marked secret and stays off the lock screen
      entirely; putting a Preview in the title would give that away without even
      needing the tap.
    -->
    <string name="standing_actions_title">Sharepaste</string>
    <string name="standing_actions_text">Offer what you copied, or Recall the latest Entry,
        without opening the app.</string>

    <!--
      Shown when the platform will not display the notification — the runtime
      grant refused on API 33 and up, or notifications switched off in Settings
      on any version. The app is not broken by it and says so: every verb still
      works from this screen.
    -->
    <string name="standing_actions_blocked_heading">STANDING ACTIONS · OFF</string>
    <string name="standing_actions_blocked">Allow notifications and you can Offer and Recall
        without opening Sharepaste. Nothing else is affected — both still work from
        here.</string>
    <string name="standing_actions_enable">TURN NOTIFICATIONS ON</string>

    <!-- The share sheet reads this. It names the verb, not the product. -->
    <string name="share_target_label">Offer to Sharepaste</string>
    <!--
      Refused, not merely unpreviewed. An Offered Capture is encrypted onto the
      Relay and decrypted into every paired device\u2019s History, which is not
