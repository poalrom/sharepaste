    <!-- %1$s is the Pairing whose History was erased. -->
    <string name="history_cleared">Cleared every Entry of %1$s.</string>
    <!-- %1$s is the Pairing that is gone, %2$s the one this phone now syncs. -->
    <string name="pairing_forgotten_promoted">Forgot %1$s. This phone now syncs %2$s.</string>
